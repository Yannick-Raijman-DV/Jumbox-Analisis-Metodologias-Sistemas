# ==========================================================================
# JUMBOX SaaS - Variables de Entorno (.env.example)
# Copiar a .env y completar los valores reales. Nunca commitear .env.
# ==========================================================================

SECRET_KEY="cambiar-en-produccion-por-una-clave-larga"

# Base de datos (vacío = SQLite local en instance/proyecto.db)
DATABASE_URL=""

# Google OAuth 2.0 (Google Cloud Console -> Credentials)
# Redirect URI autorizada: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# AWS S3 (Bucket privado con URLs prefirmadas temporales)
# Si S3_BUCKET queda vacío, las imágenes se guardan en app/static/uploads/
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="sa-east-1"
S3_BUCKET=""
S3_URL_EXPIRA="3600"

# LLM Local Pequeña (Hugging Face transformers)
# En local poner LLM_ENABLED="true"; en Render Free Tier poner "false" (límite de 512 MB RAM)
LLM_ENABLED="false"
LLM_MODEL="Qwen/Qwen2.5-0.5B-Instruct"
LLM_MAX_TOKENS="300"
